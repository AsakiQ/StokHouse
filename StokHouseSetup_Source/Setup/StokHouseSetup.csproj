<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StokHouseSetup</AssemblyName>
    <Version>0.1.1-alpha</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PayloadRoot Condition="'$(PayloadRoot)' == ''">../../package</PayloadRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Engine/StokHouse.Setup.Engine.csproj" />
    <EmbeddedResource Include="$(PayloadRoot)/StokHouse-mod.zip" LogicalName="StokHouse.mod.zip" />
    <EmbeddedResource Include="$(PayloadRoot)/modpack.json" LogicalName="StokHouse.modpack.json" />
  </ItemGroup>
</Project>
