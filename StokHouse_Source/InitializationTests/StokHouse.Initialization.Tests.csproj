<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>11</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <SmapiPath Condition="'$(SmapiPath)' == ''">$(GamePath)</SmapiPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FamilyBudgetPlaytest)' == 'true'">
    <DefineConstants>$(DefineConstants);FAMILY_BUDGET_PLAYTEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Mod/StokHouse.csproj" />
    <Reference Include="0Harmony" HintPath="$(SmapiPath)/smapi-internal/0Harmony.dll" />
    <Reference Include="StardewModdingAPI" HintPath="$(SmapiPath)/StardewModdingAPI.dll" />
    <Reference Include="SMAPI.Toolkit.CoreInterfaces" HintPath="$(SmapiPath)/smapi-internal/SMAPI.Toolkit.CoreInterfaces.dll" />
    <Reference Include="MonoMod.Common" HintPath="$(SmapiPath)/smapi-internal/MonoMod.Common.dll" />
    <Reference Include="Mono.Cecil" HintPath="$(SmapiPath)/smapi-internal/Mono.Cecil.dll" />
    <Reference Include="MonoGame.Framework" HintPath="$(GamePath)/MonoGame.Framework.dll" Condition="Exists('$(GamePath)/MonoGame.Framework.dll')" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" Condition="!Exists('$(GamePath)/MonoGame.Framework.dll')" />
  </ItemGroup>
</Project>
