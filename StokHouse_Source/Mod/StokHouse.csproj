<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>StokHouse</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <SmapiPath Condition="'$(SmapiPath)' == ''">$(GamePath)</SmapiPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/StokHouse.Core.csproj" />
    <Reference Include="StardewModdingAPI" HintPath="$(SmapiPath)/StardewModdingAPI.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(SmapiPath)/smapi-internal/0Harmony.dll" Private="false" />
    <Reference Include="SMAPI.Toolkit.CoreInterfaces" HintPath="$(SmapiPath)/smapi-internal/SMAPI.Toolkit.CoreInterfaces.dll" Private="false" />
    <Reference Include="MonoGame.Framework" HintPath="$(GamePath)/MonoGame.Framework.dll" Private="false" Condition="Exists('$(GamePath)/MonoGame.Framework.dll')" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" ExcludeAssets="runtime" Condition="!Exists('$(GamePath)/MonoGame.Framework.dll')" />
    <None Update="manifest.json;i18n/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckSmapi" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(SmapiPath)/StardewModdingAPI.dll')">
    <Error Text="Pass -p:GamePath or -p:SmapiPath with the SMAPI 4.5.2 installation files." />
  </Target>
</Project>
